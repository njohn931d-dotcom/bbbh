{
  "name": "worth",
  "version": "1.0.0",
  "private": true,
  "description": "Worth money calculators (Vite, root) + HOOKED Next.js app in hooked/ + Affiliate Income Lab static site in affiliate-marketing/ + Forge Workspace landing page in workspace-service/.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.cjs",
    "build:production": "REQUIRE_SITE_URL=1 vite build",
    "dev:hooked": "npm --prefix hooked run dev",
    "build:hooked": "npm --prefix hooked run build",
    "serve:static": "node server.js",
    "affiliate:build": "python3 affiliate-marketing/tools/build.py",
    "affiliate:check": "python3 affiliate-marketing/tools/check-seo.py"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "vite": "^6.1.0"
  }
}
